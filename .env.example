# ==============================================================================
# AI-Powered ATS Resume Builder Configuration
# ==============================================================================

# AI Provider Configuration: "gemini", "openai", or "heuristic" (local offline mode)
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Layout Preservation Threshold (fraction: 0.15 = 15% text expansion warning)
MAX_LENGTH_EXPANSION_THRESHOLD=0.15

# Server & Storage Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///storage/resume_builder.db
